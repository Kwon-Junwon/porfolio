        { label: "사용 기술", val: "Python" },
        { label: "시간 절감", val: "90%" },
        { label: "수집 항목", val: "가격·재고·리뷰" },
        { label: "형태", val: "자동화 스크립트" },
      ]
    },
  ];

  /* ── 렌더링 ── */
  const list = document.getElementById('projectList');
  projects.forEach((p, i) => {
    const el = document.createElement('div');
    el.className = 'project-item';
    el.setAttribute('role', 'button');
    el.setAttribute('tabindex', '0');
    el.innerHTML = `
      <div class="project-left">
        <div class="project-tags">${p.tags.map(t => `<span class="tag">${t}</span>`).join('')}</div>
        <p class="project-title">${p.title}</p>
        <p class="project-desc">${p.desc}</p>
      </div>
      <span class="project-year">${p.year}</span>`;
    el.addEventListener('click', () => openModal(i));
    el.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') openModal(i); });
    list.appendChild(el);
  });

  /* ── 모달 ── */
  function openModal(i) {
    const p = projects[i];
    document.getElementById('modalEyebrow').textContent = p.tags.join(' · ');
    document.getElementById('modalTitle').textContent = p.title;
    document.getElementById('modalBody').innerHTML = p.detail;
    const hl = document.getElementById('modalHighlights');
    hl.innerHTML = p.highlights.map(h =>
      `<div class="highlight-item"><p class="highlight-label">${h.label}</p><p class="highlight-val">${h.val}</p></div>`
    ).join('');
    document.getElementById('modalBackdrop').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(e) {
    if (e.target === document.getElementById('modalBackdrop')) closeModalDirect();
  }
  function closeModalDirect() {
    document.getElementById('modalBackdrop').classList.remove('open');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModalDirect(); });
</script>

</body>
</html>
