<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>포트폴리오 — 이름</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Noto+Sans+KR:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    /* ── 토큰 ── */
    :root {
      --ink:      #111111;
      --ink-2:    #555555;
      --ink-3:    #999999;
      --bg:       #F9F8F6;
      --bg-card:  #FFFFFF;
      --rule:     #E4E2DE;
      --accent:   #1A3A5C;
      --accent-lt:#EEF2F7;
      --serif:    'DM Serif Display', Georgia, serif;
      --sans:     'Noto Sans KR', sans-serif;
      --max:      720px;
      --gap:      clamp(2.5rem, 6vw, 5rem);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-weight: 300;
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
    }

    /* ── 레이아웃 ── */
    .container {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    section { padding: var(--gap) 0; }
    section + section { border-top: 1px solid var(--rule); }

    /* ── 네비 ── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(249,248,246,0.88);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--rule);
    }
    .nav-inner {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-logo {
      font-family: var(--serif);
      font-size: 1.05rem;
      color: var(--ink);
      text-decoration: none;
      letter-spacing: 0.01em;
    }
    .nav-links { display: flex; gap: 1.75rem; list-style: none; }
    .nav-links a {
      font-size: 0.8rem;
      font-weight: 400;
      color: var(--ink-2);
      text-decoration: none;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: color .2s;
    }
    .nav-links a:hover { color: var(--ink); }

    /* ── 히어로 ── */
    #hero { padding-top: clamp(3.5rem, 10vw, 7rem); padding-bottom: clamp(3rem, 8vw, 6rem); border-top: none; }

    .eyebrow {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-lt);
      padding: 4px 12px;
      border-radius: 2px;
      margin-bottom: 1.5rem;
    }

    .hero-name {
      font-family: var(--serif);
      font-size: clamp(2.6rem, 6vw, 4rem);
      line-height: 1.15;
      letter-spacing: -0.01em;
      color: var(--ink);
      margin-bottom: 1.2rem;
    }
    .hero-name em {
      font-style: normal;
      color: var(--accent);
    }

    .hero-sub {
      font-size: 1rem;
      font-weight: 300;
      color: var(--ink-2);
      max-width: 480px;
      line-height: 1.8;
      margin-bottom: 2rem;
    }

    .hero-meta {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .meta-item {
      font-size: 0.78rem;
      color: var(--ink-3);
      letter-spacing: 0.04em;
    }
    .meta-item strong {
      display: block;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--ink);
      margin-bottom: 1px;
    }

    /* ── 섹션 레이블 ── */
    .section-label {
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-3);
      margin-bottom: 2rem;
    }

    /* ── 프로젝트 ── */
    .project-list { display: flex; flex-direction: column; gap: 0; }

    .project-item {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 1rem;
      padding: 1.6rem 0;
      border-bottom: 1px solid var(--rule);
      text-decoration: none;
      color: inherit;
      transition: opacity .2s;
      cursor: pointer;
    }
    .project-item:first-child { border-top: 1px solid var(--rule); }
    .project-item:hover { opacity: 0.7; }

    .project-left {}
    .project-tags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 0.55rem;
    }
    .tag {
      font-size: 0.7rem;
      font-weight: 400;
      color: var(--accent);
      background: var(--accent-lt);
      padding: 2px 9px;
      border-radius: 2px;
      letter-spacing: 0.03em;
    }
    .project-title {
      font-family: var(--serif);
      font-size: 1.2rem;
      color: var(--ink);
      margin-bottom: 0.35rem;
      line-height: 1.3;
    }
    .project-desc {
      font-size: 0.85rem;
      color: var(--ink-2);
      line-height: 1.7;
      max-width: 520px;
    }
    .project-year {
      font-size: 0.78rem;
      color: var(--ink-3);
      white-space: nowrap;
      padding-top: 0.25rem;
    }

    /* ── 모달 ── */
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(17,17,17,0.45);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .modal-backdrop.open { display: flex; }

    .modal {
      background: var(--bg-card);
      border-radius: 4px;
      max-width: 600px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      padding: 2.5rem;
      position: relative;
    }
    .modal-close {
      position: absolute;
      top: 1.2rem; right: 1.4rem;
      background: none;
      border: none;
      font-size: 1.4rem;
      color: var(--ink-3);
      cursor: pointer;
      line-height: 1;
    }
    .modal-close:hover { color: var(--ink); }
    .modal-eyebrow { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.6rem; }
    .modal-title { font-family: var(--serif); font-size: 1.7rem; line-height: 1.2; color: var(--ink); margin-bottom: 1.2rem; }
    .modal-body { font-size: 0.9rem; color: var(--ink-2); line-height: 1.9; }
    .modal-body p + p { margin-top: 1rem; }
    .modal-body strong { font-weight: 500; color: var(--ink); }
    .modal-highlights {
      margin-top: 1.5rem;
      border-top: 1px solid var(--rule);
      padding-top: 1.2rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 1rem;
    }
    .highlight-item {}
    .highlight-label { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 3px; }
    .highlight-val { font-size: 0.9rem; font-weight: 500; color: var(--ink); }

    /* ── 스킬 ── */
    .skill-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
    }
    .skill-group-title {
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-3);
      margin-bottom: 0.8rem;
    }
    .skill-items { display: flex; flex-direction: column; gap: 0.5rem; }
    .skill-row { display: flex; align-items: center; gap: 0.75rem; }
    .skill-name { font-size: 0.88rem; color: var(--ink-2); min-width: 90px; }
    .skill-bar-bg { flex: 1; height: 3px; background: var(--rule); border-radius: 2px; }
    .skill-bar-fill { height: 100%; background: var(--accent); border-radius: 2px; }

    /* ── 연락처 ── */
    .contact-grid {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .contact-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--ink-2);
      text-decoration: none;
      border: 1px solid var(--rule);
      padding: 8px 18px;
      border-radius: 2px;
      transition: border-color .2s, color .2s;
    }
    .contact-link:hover { border-color: var(--accent); color: var(--accent); }
    .contact-link svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

    /* ── 푸터 ── */
    footer {
      border-top: 1px solid var(--rule);
      padding: 2rem 0;
      text-align: center;
      font-size: 0.75rem;
      color: var(--ink-3);
      letter-spacing: 0.04em;
    }

    /* ── 반응형 ── */
    @media (max-width: 500px) {
      .nav-links { display: none; }
      .project-item { grid-template-columns: 1fr; }
      .project-year { display: none; }
      .modal { padding: 1.8rem 1.4rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>
